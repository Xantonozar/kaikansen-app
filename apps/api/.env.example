PORT=
MONGODB_URI=
JWT_SECRET=
JWT_REFRESH_SECRET=
ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=
<redacted>=
ANILIST_POST_LOGIN_REDIRECT=
SYNC_SECRET=

# Password reset email (Brevo transactional API). MAIL_FROM must be a
# verified Brevo sender, chosen at deploy time. Unset = reset emails
# are skipped; the reset endpoints still answer their generic 200.
BREVO_API_KEY=
MAIL_FROM=

# Phase 2 quiz head cache (solo quiz). Both optional: the cache
# directory defaults to `quiz-heads-cache` under the service
# working directory, the size budget to 500 MB. The cache is
# disposable — losing the directory only costs re-warming.
QUIZ_HEAD_CACHE_DIR=
QUIZ_HEAD_CACHE_MAX_MB=
